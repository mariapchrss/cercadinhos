<Window x:Class="Cercadinhos.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" AllowDrop="True"
        MinWidth="150" MinHeight="32"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseEnter="Win_MouseEnter" MouseLeave="Win_MouseLeave">
    <Window.Resources>
        <!-- alça invisível de redimensionar -->
        <Style x:Key="Alca" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Border x:Name="Frame" CornerRadius="12" BorderThickness="1" BorderBrush="#40FFFFFF">
            <DockPanel>
                <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="30" CornerRadius="11,11,0,0" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Title_MouseLeftButtonDown" MouseRightButtonUp="Title_MouseRightButtonUp">
                    <Grid>
                        <Border x:Name="BackBtn" Width="26" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                Margin="4,0,0,0" Background="Transparent" Cursor="Hand" ToolTip="Voltar" Visibility="Collapsed"
                                MouseLeftButtonDown="BackBtn_MouseLeftButtonDown">
                            <TextBlock x:Name="BackArrow" Text="‹" Foreground="White" FontSize="18" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Border>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="Dois cliques pra renomear"
                                   MouseLeftButtonDown="TitleText_MouseLeftButtonDown"/>
                        <!-- abas dividindo a barra inteira, como no Fences -->
                        <UniformGrid x:Name="TabsPanel" Rows="1" Margin="3,0,30,0" Visibility="Collapsed"/>
                        <TextBox x:Name="TitleEdit" Visibility="Collapsed" FontSize="13" Margin="30,3"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostFocus"/>
                        <Border x:Name="MenuBtn" Width="26" Height="22" CornerRadius="6" HorizontalAlignment="Right"
                                Margin="0,0,4,0" Background="Transparent" Cursor="Hand" ToolTip="Opções"
                                MouseLeftButtonDown="MenuBtn_MouseLeftButtonDown">
                            <TextBlock x:Name="MenuDots" Text="⋯" Foreground="White" FontSize="15" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                    </Grid>
                </Border>
                <Grid x:Name="Body" Background="Transparent">
                    <TextBlock x:Name="Hint" Text="Arraste arquivos pra cá" Foreground="#AAFFFFFF" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6,4,6,6">
                        <!-- barrinha fina por cima do conteúdo: a normal rouba largura e derruba uma coluna -->
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border CornerRadius="3" Background="#AAFFFFFF"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>
                        <ScrollViewer.Template>
                            <ControlTemplate TargetType="ScrollViewer">
                                <Grid>
                                    <ScrollContentPresenter/>
                                    <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="6" MinWidth="6" Margin="0,0,-4,0"
                                               Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                </Grid>
                            </ControlTemplate>
                        </ScrollViewer.Template>
                        <ItemsControl x:Name="List"
                                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="List_PreviewMouseMove"
                                      MouseRightButtonUp="List_MouseRightButtonUp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="B" CornerRadius="8" Background="Transparent" ToolTip="{Binding Name}"
                                            Width="{Binding CellW, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Height="{Binding CellH, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Margin="4,6,4,2">
                                            <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- tinta: uma cor só por cima, no formato do ícone -->
                                                <Rectangle Fill="{Binding TintBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Opacity="{Binding TintOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                       Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="{Binding TextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontWeight="{Binding TextWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       MaxHeight="{Binding NameMaxH, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Visibility="{Binding NamesVis, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Effect="{Binding TextEffect, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- risquinho mostrando onde o ícone arrastado vai entrar -->
                                        <DataTrigger Binding="{Binding Alvo}" Value="True">
                                            <Setter TargetName="B" Property="BorderThickness" Value="2,0,0,0"/>
                                            <Setter TargetName="B" Property="BorderBrush" Value="{Binding TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="B" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
        <Path x:Name="Grip" Data="M11,1 L1,11 M11,5 L5,11 M11,9 L9,11" Stroke="White" StrokeThickness="1.5" Opacity="0.55"
              Width="12" Height="12" IsHitTestVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
        <!-- alças nas bordas e nos cantos -->
        <Grid x:Name="Alcas">
            <Thumb Style="{StaticResource Alca}" Tag="L" Width="5" HorizontalAlignment="Left" Margin="0,12" Cursor="SizeWE" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="R" Width="5" HorizontalAlignment="Right" Margin="0,12" Cursor="SizeWE" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="T" Height="4" VerticalAlignment="Top" Margin="12,0" Cursor="SizeNS" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="B" Height="5" VerticalAlignment="Bottom" Margin="12,0" Cursor="SizeNS" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="TL" Width="12" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="TR" Width="12" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="BL" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="Alca_DragDelta"/>
            <Thumb Style="{StaticResource Alca}" Tag="BR" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Alca_DragDelta"/>
        </Grid>
    </Grid>
</Window>
