<Window x:Class="Cercadinhos.CentralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cercadinhos" Width="960" Height="660" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="/assets/Cercadinhos.ico"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
        FontFamily="Segoe UI" FontSize="13.5" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DockPanel Margin="10,14,10,12">
            <TextBlock x:Name="Versao" DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource TextoSuave}" Margin="12,0,0,0"/>
            <StackPanel x:Name="Menu"/>
        </DockPanel>
        <Border Grid.Column="1" Background="#FAFAFA" BorderBrush="{StaticResource Linha}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Pagina" Margin="32,24,32,24"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
